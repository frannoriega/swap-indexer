# Copy to .env and fill in. Loaded by both binaries via dotenv.

# Postgres — matches docker-compose.yml.
DATABASE_URL=postgres://swap:swap@localhost:5432/swaps

# Yellowstone gRPC endpoint. Use a free-tier provider (Triton / Helius / Shyft).
# URL is required; the token is optional depending on the provider.
YELLOWSTONE_GRPC_URL=https://your-provider-grpc-endpoint:443
YELLOWSTONE_X_TOKEN=

# Optional: address the API binds to (default 0.0.0.0:3000).
# API_ADDR=0.0.0.0:3000

# Logging (both binaries use env_logger).
RUST_LOG=info
